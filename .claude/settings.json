{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git clone:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew bootRun:*)",
      "Bash(./gradlew flywayInfo:*)",
      "Bash(./gradlew flywayMigrate:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter build:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard*)",
      "Bash(git stash*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout -- *)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets.json)",
      "Read(./backend/src/main/resources/application-secret.properties)"
    ]
  }
}
